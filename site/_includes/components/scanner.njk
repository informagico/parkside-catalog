<dialog id="label-scanner" class="label-scanner" aria-labelledby="scan-title" aria-describedby="scan-privacy">
 <div class="scan-heading"><h2 id="scan-title">{{ 'scanTitle' | t(lang) }}</h2><button id="scan-close" type="button" aria-label="{{ 'scanClose' | t(lang) }}">×</button></div>
 <p id="scan-privacy" class="scan-privacy">{{ 'scanPrivacy' | t(lang) }}</p>
 <p>{{ 'scanHint' | t(lang) }}</p>
 <div class="scan-actions"><button id="scan-camera" class="secondary" type="button">{{ 'scanCamera' | t(lang) }}</button><button id="scan-gallery" class="secondary" type="button">{{ 'scanGallery' | t(lang) }}</button></div>
 <input id="scan-camera-file" type="file" accept="image/*" capture="environment" hidden>
 <input id="scan-gallery-file" type="file" accept="image/*" hidden>
 <section id="scan-image" hidden aria-label="{{ 'scanPreview' | t(lang) }}">
  <div class="scan-actions scan-edit-actions"><button id="scan-crop" type="button" aria-pressed="false" aria-controls="scan-preview">{{ 'scanCrop' | t(lang) }}</button><button id="scan-rotate" type="button">↻ {{ 'scanRotate' | t(lang) }}</button><button id="scan-reset-crop" type="button">{{ 'scanResetCrop' | t(lang) }}</button></div>
  <p id="scan-crop-hint" aria-live="polite">{{ 'scanCropHint' | t(lang) }}</p>
  <div class="scan-preview"><div class="scan-crop-surface"><canvas id="scan-preview" aria-label="{{ 'scanPreview' | t(lang) }}" aria-describedby="scan-crop-hint"></canvas><div id="scan-selection" hidden aria-label="{{ 'scanSelection' | t(lang) }}"></div></div></div>
  <label class="scan-use-text"><input id="scan-use-text" type="checkbox" checked>{{ 'scanHybridUseText' | t(lang) }}</label>
  <div class="scan-actions scan-run-actions"><button id="scan-visual" class="primary" type="button">{{ 'scanVisual' | t(lang) }}</button><button id="scan-read" class="secondary" type="button">{{ 'scanRead' | t(lang) }}</button></div>
  <p class="scan-search-hint">{{ 'scanVisualDownloadHint' | t(lang) }}</p>
 </section>
 <p id="scan-status" role="status" aria-live="polite"></p>
 <progress id="scan-progress" max="1" hidden aria-label="{{ 'scanRead' | t(lang) }}"></progress>
 <div id="scan-candidates" class="scan-candidates" role="group" aria-label="{{ 'scanCandidates' | t(lang) }}" hidden></div>
 <details id="scan-ocr-details" hidden><summary>{{ 'scanHybridReadText' | t(lang) }}</summary><p id="scan-ocr-text"></p></details>
 <section id="scan-visual-results" aria-labelledby="scan-visual-title" hidden><h3 id="scan-visual-title">{{ 'scanVisualResults' | t(lang) }}</h3><p>{{ 'scanVisualDisclaimer' | t(lang) }}</p><p id="scan-visual-coverage" class="scan-search-hint"></p><ol id="scan-matches" class="scan-matches"></ol></section>
 <form id="scan-form"><label for="scan-query">{{ 'scanQuery' | t(lang) }}</label><div class="scan-query-row"><input id="scan-query" type="text" required maxlength="100" autocomplete="off" spellcheck="false" placeholder="IAN 407702_2207 / PABS 20-Li D5"><button class="primary" type="submit">{{ 'scanSearch' | t(lang) }}</button></div><p class="scan-search-hint">{{ 'scanSearchHint' | t(lang) }}</p></form>
</dialog>
