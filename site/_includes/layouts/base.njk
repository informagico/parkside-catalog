<!doctype html>
<html lang="{{ lang }}"{% if pageType == 'catalog' %} class="catalog-document"{% endif %}>
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  {% include 'components/clean-url.njk' %}
  <meta name="description" content="{{ 'description' | t(lang) | escape }}">
  <title>{% if pageType == 'comparison' %}{{ 'compareTitle' | t(lang) }}{% elif title %}{{ title | escape }}{% else %}{{ 'catalog' | t(lang) }}{% endif %} · Parkside Atlas</title>
  {% for code in languages %}<link rel="alternate" hreflang="{{ code }}" href="{{ page.outputPath | localeTarget(code) | rel(page.outputPath) }}">{% endfor %}
  <link rel="stylesheet" href="{{ 'assets/style.css' | rel(page.outputPath) }}">
  <link rel="stylesheet" href="{{ 'assets/locales.css' | rel(page.outputPath) }}">
  <link rel="stylesheet" href="{{ 'assets/refinements.css' | rel(page.outputPath) }}?v=20261027-contribution-empty">
  {% if pageType == 'catalog' %}<link rel="stylesheet" href="{{ 'assets/catalog.css' | rel(page.outputPath) }}"><link rel="stylesheet" href="{{ 'assets/scanner.css' | rel(page.outputPath) }}">{% endif %}
  <link rel="stylesheet" href="{{ 'assets/compare.css' | rel(page.outputPath) }}">
</head>
<body{% if pageType == 'catalog' %} class="catalog-page"{% endif %}>
<a class="skip" href="#main">{{ 'skip' | t(lang) }}</a>
<header>
  <a class="brand" href="{{ (lang + '/index.html') | rel(page.outputPath) }}"><span class="brandmark">PA<span>↗</span></span><span>PARKSIDE ATLAS<span class="brand-sub">{{ 'brandSubtitle' | t(lang) }}</span></span></a>
  <nav aria-label="{{ 'navigation' | t(lang) }}">
    <a href="{{ (lang + '/index.html') | rel(page.outputPath) }}#catalogue">{{ 'catalog' | t(lang) }}</a>
    <a class="contribute-nav" href="{{ (lang + '/contribute/index.html') | rel(page.outputPath) }}">{{ 'contribute' | t(lang) }}</a>
    <a class="method-nav" href="{{ (lang + '/method/index.html') | rel(page.outputPath) }}">{{ 'method' | t(lang) }}</a>
    <div class="language-switch" aria-label="{{ 'language' | t(lang) }}">{% for code in languages %}<a class="language-link{% if code == lang %} active{% endif %}" data-language-link="{{ code }}" href="{{ page.outputPath | localeTarget(code) | rel(page.outputPath) }}" lang="{{ code }}" hreflang="{{ code }}"{% if code == lang %} aria-current="page"{% endif %}>{{ code | upper }}</a>{% endfor %}</div>
    <a class="repo-link" href="{{ site.repository }}" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
  </nav>
</header>
<main id="main">{{ content | safe }}</main>
{% if pageType != 'catalog' %}{% include 'components/footer.njk' %}{% endif %}
<aside id="compare-tray" class="compare-tray" aria-label="{{ 'compareTitle' | t(lang) }}" hidden>
 <span id="compare-count"></span><div id="compare-items" class="compare-items"></div>
 <a class="primary" data-compare-link href="{{ (lang + '/compare/index.html') | rel(page.outputPath) }}">{{ 'compareOpen' | t(lang) }}</a>
 <button type="button" id="compare-clear">{{ 'compareClear' | t(lang) }}</button>
</aside>
<p id="compare-status" class="compare-status" role="status" aria-live="polite"></p>
<script id="comparison-i18n" type="application/json">{{ lang | comparisonMessages | jsonScript | safe }}</script>
<script type="module" src="{{ 'assets/compare.js' | rel(page.outputPath) }}?v=20261027-clean-urls"></script>
<script src="{{ 'assets/language.js' | rel(page.outputPath) }}" defer></script>
<script src="{{ 'assets/photos.js' | rel(page.outputPath) }}" defer></script>
{% if pageType == 'catalog' %}<script id="client-i18n" type="application/json">{{ lang | clientMessages | jsonScript | safe }}</script><script src="{{ 'assets/app.js' | rel(page.outputPath) }}?v=20261027-clean-urls" defer></script><script type="module" src="{{ 'assets/scanner.js' | rel(page.outputPath) }}"></script>{% endif %}
{% if pageType != 'catalog' %}<script src="{{ 'assets/return.js' | rel(page.outputPath) }}?v=20261027-clean-urls" defer></script>{% endif %}
{% if pageType == 'contribute' %}<script src="{{ 'assets/contribute.js' | rel(page.outputPath) }}?v=20261027-contribution-empty" defer></script>{% endif %}
</body></html>
