---
layout: layouts/base.njk
pagination:
  data: catalog.entries
  size: 1
  alias: entry
permalink: "{{ entry.lang }}/products/{{ entry.product.slug }}/index.html"
---
{% from 'components/media.njk' import media %}
{% set p = entry.product %}
{% set related = catalog.localized[lang] | sameModel(p.model,p.slug,p.category) %}
<div class="detail">
 <a class="back" href="{{ (lang + '/index.html') | rel(page.outputPath) }}#catalogue">← {{ 'back' | t(lang) }}</a>
 <div class="detail-top"><div class="detail-visual">{{ media(p,lang,page.outputPath,'eager') }}<span>{% if p.image %}{{ 'productPhoto' | t(lang) }}{% else %}{{ 'categoryArt' | t(lang) }}{% endif %}</span></div><div><span class="eyebrow">{{ p.category | escape }} / IAN {{ p.ian }}</span><h1>{{ (p.model or p.title) | escape }}</h1>{% if p.model %}<p class="detail-title" lang="{{ p.textLanguages.title }}">{{ p.title | escape }}</p>{% endif %}{% if p.preview.modelIanCount > 1 %}<a class="badge badge-models badge-ians" href="#model-variants-title" title="{{ 'multipleIansHint' | t(lang) }}">{{ 'multipleIansForModel' | t(lang, {count: p.preview.modelIanCount}) }}</a>{% endif %}<div class="detail-tags">{% if p.preview.batteryCapacity %}<span>{{ p.preview.batteryCapacity | escape }}</span>{% for range in p.preview.ranges %}<span>{{ range | escape }}</span>{% endfor %}{% endif %}{% if p.powerKey != 'Unverified' and p.powerKey != 'To be verified' %}<span>{{ p.power | escape }}</span>{% endif %}{% if p.market %}<span>{{ p.market | escape }}</span>{% endif %}</div></div></div>
 {% if p.translationNeedsReview %}<p class="translation-notice" role="note">{{ 'translationReview' | t(lang) }}</p>{% elif p.translationMissing %}<p class="translation-notice" role="note">{{ 'translationMissing' | t(lang) }}</p>{% endif %}
 <p><button class="secondary" type="button" data-compare-ian="{{ p.ian }}" data-compare-model="{{ (p.model or p.title) | escape }}" aria-pressed="false" hidden>{{ 'compareAdd' | t(lang) }}</button></p>
 <p><a class="secondary correction-link" href="{{ p | correctionUrl | escape }}" target="_blank" rel="noopener noreferrer">{{ 'reportCorrection' | t(lang) }} ↗</a></p>
  {% if related | length %}{% set variants = catalog.localized[lang] | modelVariants(p.model,p.category) %}{% set differences = variants | variantDifferences %}<section class="panel model-variants" aria-labelledby="model-variants-title"><div class="model-variants-heading"><h2 id="model-variants-title">{{ 'variants' | t(lang) }}</h2><span class="model-variants-count">{{ variants | length }} IAN</span></div><p>{{ 'variantIntro' | t(lang) }}</p><p class="variant-scroll-hint">{{ 'variantScrollHint' | t(lang) }} <span aria-hidden="true">&rarr;</span></p><div class="table-scroll" tabindex="0" role="region" aria-labelledby="model-variants-title"><table class="variant-table"><thead><tr><th scope="col">IAN</th><th scope="col">{{ 'manufacturer' | t(lang) }}</th><th scope="col">{{ 'power' | t(lang) }}</th>{% for key in differences %}<th scope="col">{{ key | escape }}</th>{% endfor %}</tr></thead><tbody>{% for q in variants %}<tr{% if q.ian == p.ian %} class="current-variant"{% endif %}><th scope="row">{% if q.ian == p.ian %}<span class="variant-current-ian" aria-current="page">{{ q.ian }}</span><small class="variant-current-label">{{ 'currentVariant' | t(lang) }}</small>{% else %}<a class="variant-ian-link" href="{{ (lang + '/products/' + q.slug + '/index.html') | rel(page.outputPath) }}">{{ q.ian }} <span aria-hidden="true">&rarr;</span></a>{% endif %}</th><td>{{ (q.manufacturer or ('unknown' | t(lang))) | escape }}</td><td>{{ q.power | escape }}</td>{% for key in differences %}{% set value = q.specifications[key] or '—' %}<td{% if value | length > 80 %} class="variant-long-value"{% endif %}>{{ value | escape }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div></section>{% endif %}
 <div class="detail-columns{% if not p.manual and not p.documents %} detail-columns--full{% endif %}"><div>
  <section class="panel"><span class="eyebrow">{{ 'identity' | t(lang) }}</span><h2>{{ 'behind' | t(lang) }}</h2><dl><dt>{{ 'manufacturer' | t(lang) }}</dt><dd>{% if p.manufacturer %}{{ p.manufacturer | escape }}{% else %}{{ 'unknown' | t(lang) }}{% endif %}</dd></dl></section>
  <section class="panel"><span class="eyebrow">{{ 'technical' | t(lang) }}</span><h2>{{ 'details' | t(lang) }}</h2><div lang="{{ p.textLanguages.body }}">{{ p.body | markdown | safe }}</div>{% if (p.specifications | keys | length) > 0 %}<dl>{% for key,value in p.specifications %}<dt>{{ key | escape }}</dt><dd>{{ value | escape }}</dd>{% endfor %}</dl>{% endif %}</section>
 </div><aside>
  {% if p.manual %}<section class="panel"><h2>{% if p.manuals and p.manuals | length > 1 %}{{ 'manuals' | t(lang) }}{% else %}{{ 'manual' | t(lang) }}{% endif %}</h2>{% if p.manuals %}{% for manual in p.manuals %}<a class="variant" href="{{ manual.url | escape }}" target="_blank" rel="noopener noreferrer">{{ manual.model | escape }} · {{ 'manualPdf' | t(lang) }} ↗</a>{% endfor %}{% else %}<a class="variant" href="{{ p.manual | escape }}" target="_blank" rel="noopener noreferrer">{{ 'manualPdf' | t(lang) }} ↗</a>{% endif %}</section>{% endif %}
  {% if p.documents %}<section class="panel"><h2>{{ 'productDocuments' | t(lang) }}</h2>{% for document in p.documents %}<a class="variant" href="{{ document.url | escape }}" target="_blank" rel="noopener noreferrer">{{ 'warrantyPdf' | t(lang) }} ↗</a>{% endfor %}</section>{% endif %}

 </aside></div>
</div>
