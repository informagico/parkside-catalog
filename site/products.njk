---
layout: layouts/base.njk
pagination:
  data: catalog.entries
  size: 1
  alias: entry
permalink: "{{ entry.lang }}/products/{{ entry.product.slug }}/index.html"
---
{% from 'components/media.njk' import media %}
{% set p = entry.product %}
<div class="detail">
 <a class="back" href="{{ (lang + '/index.html') | rel(page.outputPath) }}#catalogue">← {{ 'back' | t(lang) }}</a>
 <div class="detail-top"><div class="detail-visual">{{ media(p,lang,page.outputPath,'eager') }}<span>{% if p.image %}{{ 'productPhoto' | t(lang) }}{% else %}{{ 'categoryArt' | t(lang) }}{% endif %}</span></div><div><span class="eyebrow">{{ p.category | escape }} / IAN {{ p.ian }}</span><h1>{{ p.model | escape }}</h1><p class="detail-title">{{ p.title | escape }}</p><span class="badge{% if p.manufacturer %} confirmed{% endif %}"><i></i>{% if p.manufacturer %}{{ 'manufacturerVerified' | t(lang) }}{% else %}{{ 'manufacturerUnknown' | t(lang) }}{% endif %}</span><div class="detail-tags"><span>{{ p.power | escape }}</span><span>{% if p.market %}{{ p.market | escape }}{% else %}{{ 'unknownMarket' | t(lang) }}{% endif %}</span></div></div></div>
 <div class="detail-columns"><div>
  <section class="panel"><span class="eyebrow">{{ 'identity' | t(lang) }}</span><h2>{{ 'behind' | t(lang) }}</h2><dl><dt>{{ 'company' | t(lang) }}</dt><dd>{{ p.company | escape }}</dd><dt>{{ 'manufacturer' | t(lang) }}</dt><dd>{% if p.manufacturer %}{{ p.manufacturer | escape }}{% else %}{{ 'unknown' | t(lang) }}{% endif %}</dd></dl><div class="evidence"><strong>{{ 'evidence' | t(lang) }}</strong><p>{{ p.evidence | escape }}</p></div></section>
  <section class="panel"><span class="eyebrow">{{ 'technical' | t(lang) }}</span><h2>{{ 'details' | t(lang) }}</h2>{% if (p.specifications | keys | length) > 0 %}<dl>{% for key,value in p.specifications %}<dt>{{ key | escape }}</dt><dd>{{ value | escape }}</dd>{% endfor %}</dl>{% else %}<p class="muted">{{ 'missingSpecs' | t(lang) }}</p>{% endif %}{{ p.body | markdown | safe }}</section>
 </div><aside>
  <section class="panel sources"><span class="eyebrow">{{ 'documentation' | t(lang) }}</span><h2>{{ 'followSources' | t(lang) }}</h2><a href="{{ p.source | escape }}" target="_blank" rel="noopener noreferrer">{{ (p | primaryLabel) | t(lang) }} ↗</a>{% if p.technical_source %}<a href="{{ p.technical_source | escape }}" target="_blank" rel="noopener noreferrer">{{ 'technicalSource' | t(lang) }} ↗</a>{% endif %}{% if p.image %}<a href="{{ p.image.source | escape }}" target="_blank" rel="noopener noreferrer">{{ 'photoSource' | t(lang) }}: {{ p.image.owner | escape }} ↗</a>{% endif %}<a href="{{ ('data/markdown/' + p.file) | rel(page.outputPath) }}" download>{{ 'downloadMarkdown' | t(lang) }} ↓</a><a href="{{ site.repository }}/blob/{{ site.branch }}/content/products/{{ p.file }}" target="_blank" rel="noopener noreferrer">{{ 'openGithub' | t(lang) }} ↗</a><small>{{ 'lastChecked' | t(lang) }}: {{ p.checked }}<br>{{ 'privateRepo' | t(lang) }}</small></section>
  {% set related = catalog.localized[lang] | sameModel(p.model,p.slug) %}{% if related | length %}<section class="panel"><h2>{{ 'variants' | t(lang) }}</h2>{% for q in related %}<a class="variant" href="{{ (lang + '/products/' + q.slug + '/index.html') | rel(page.outputPath) }}">IAN {{ q.ian }} →</a>{% endfor %}</section>{% endif %}
 </aside></div>
</div>
