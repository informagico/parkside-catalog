---
layout: layouts/base.njk
pagination:
  data: catalog.entries
  size: 1
  alias: entry
permalink: "{{ entry.lang }}/products/{{ entry.product.slug }}/index.html"
---
{% from 'components/media.njk' import media %}
{% set p = entry.product %}
{% set related = catalog.localized[lang] | sameModel(p.model,p.slug) %}
<div class="detail">
 <a class="back" href="{{ (lang + '/index.html') | rel(page.outputPath) }}#catalogue">← {{ 'back' | t(lang) }}</a>
 <div class="detail-top"><div class="detail-visual">{{ media(p,lang,page.outputPath,'eager') }}<span>{% if p.image %}{{ 'productPhoto' | t(lang) }}{% else %}{{ 'categoryArt' | t(lang) }}{% endif %}</span></div><div><span class="eyebrow">{{ p.category | escape }} / IAN {{ p.ian }}</span><h1>{{ p.model | escape }}</h1><p class="detail-title" lang="{{ p.textLanguages.title }}">{{ p.title | escape }}</p><span class="badge{% if p.manufacturer %} confirmed{% endif %}"><i></i>{% if p.manufacturer %}{% if p.manufacturer_basis == 'owner_confirmation' %}{{ 'manufacturerOwnerConfirmed' | t(lang) }}{% else %}{{ 'manufacturerVerified' | t(lang) }}{% endif %}{% else %}{{ 'manufacturerUnknown' | t(lang) }}{% endif %}</span><div class="detail-tags">{% if p.powerKey != 'Unverified' and p.powerKey != 'To be verified' %}<span>{{ p.power | escape }}</span>{% endif %}{% if p.market %}<span>{{ p.market | escape }}</span>{% endif %}</div></div></div>
 {% if p.translationNeedsReview %}<p class="translation-notice" role="note">{{ 'translationReview' | t(lang) }}</p>{% elif p.translationMissing %}<p class="translation-notice" role="note">{{ 'translationMissing' | t(lang) }}</p>{% endif %}
 <div class="detail-columns{% if not p.manual and not (related | length) %} detail-columns--full{% endif %}"><div>
  <section class="panel"><span class="eyebrow">{{ 'identity' | t(lang) }}</span><h2>{{ 'behind' | t(lang) }}</h2><dl><dt>{{ 'manufacturer' | t(lang) }}</dt><dd>{% if p.manufacturer %}{{ p.manufacturer | escape }}{% else %}{{ 'unknown' | t(lang) }}{% endif %}</dd></dl></section>
  <section class="panel"><span class="eyebrow">{{ 'technical' | t(lang) }}</span><h2>{{ 'details' | t(lang) }}</h2><div lang="{{ p.textLanguages.body }}">{{ p.body | markdown | safe }}</div>{% if (p.specifications | keys | length) > 0 %}<dl>{% for key,value in p.specifications %}<dt>{{ key | escape }}</dt><dd>{{ value | escape }}</dd>{% endfor %}</dl>{% endif %}</section>
 </div><aside>
  {% if p.manual %}<section class="panel"><h2>{{ 'manual' | t(lang) }}</h2><a class="variant" href="{{ p.manual | escape }}" target="_blank" rel="noopener noreferrer">{{ 'manualPdf' | t(lang) }} ↗</a></section>{% endif %}
  {% if related | length %}<section class="panel"><h2>{{ 'variants' | t(lang) }}</h2>{% for q in related %}<a class="variant" href="{{ (lang + '/products/' + q.slug + '/index.html') | rel(page.outputPath) }}">IAN {{ q.ian }} →</a>{% endfor %}</section>{% endif %}
 </aside></div>
</div>
