---
layout: layouts/base.njk
pageType: catalog
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang }}/index.html"
---
{% from 'components/media.njk' import media %}
{% set products = catalog.localized[lang] %}
{% set options = catalog.options[lang] %}
<section class="hero">
 <div class="hero-copy"><div class="eyebrow"><i></i>{{ 'eyebrow' | t(lang) }}</div><h1>{{ 'heroTitle' | t(lang) }}<br><em>{{ 'heroAccent' | t(lang) }}</em></h1><p>{{ 'heroText' | t(lang) }}</p><a class="primary" href="#catalogue">{{ 'explore' | t(lang) }} ↓</a><div class="hero-numbers"><div><b>{{ catalog.count }}</b><span>{{ 'records' | t(lang) }}</span></div><div><b>{{ catalog.models }}</b><span>{{ 'models' | t(lang) }}</span></div><div><b>{{ catalog.verified }}</b><span>{{ 'documented' | t(lang) }}</span></div></div></div>
</section>
<div class="manifesto"><span>{{ 'traceability' | t(lang) }}</span><p>{{ 'manifesto' | t(lang) }}</p><a href="{{ (lang + '/method/index.html') | rel(page.outputPath) }}">{{ 'verification' | t(lang) }} ↗</a></div>
<section id="catalogue" class="catalog">
 <div class="section-heading"><div><span class="eyebrow">{{ 'openArchive' | t(lang) }}</span><h2>{{ 'catalogHeading' | t(lang) }}</h2></div><a href="{{ (lang + '/data/catalog.json') | rel(page.outputPath) }}" download>{{ 'export' | t(lang) }} ↓</a></div>
 <div class="search"><span aria-hidden="true">⌕</span><input id="search" type="search" aria-label="{{ 'search' | t(lang) }}" placeholder="{{ 'search' | t(lang) }}"><kbd>/</kbd></div>
 <div class="catalog-layout">
  <aside class="filters" aria-label="{{ 'filters' | t(lang) }}">
   <div class="filter-heading">{{ 'filters' | t(lang) }}<button id="reset" type="button">{{ 'reset' | t(lang) }}</button></div>
   <label>{{ 'category' | t(lang) }}<select id="category"><option value="">{{ 'allCategories' | t(lang) }}</option>{% for item in options.categories %}<option value="{{ item.value | escape }}">{{ item.label | escape }}</option>{% endfor %}</select></label>
   <label>{{ 'company' | t(lang) }}<select id="company"><option value="">{{ 'allCompanies' | t(lang) }}</option>{% for item in options.companies %}<option value="{{ item.value | escape }}">{{ item.label | escape }}</option>{% endfor %}</select></label>
   <label>{{ 'power' | t(lang) }}<select id="power"><option value="">{{ 'allPower' | t(lang) }}</option>{% for item in options.power %}<option value="{{ item.value | escape }}">{{ item.label | escape }}</option>{% endfor %}</select></label>
   <label class="checkbox"><input type="checkbox" id="confirmed">{{ 'onlyDocumented' | t(lang) }}</label>
   <div class="filter-note"><span>↳ {{ 'oneSource' | t(lang) }}</span><p>{{ 'filterNote' | t(lang) }}</p><a href="{{ (lang + '/method/index.html') | rel(page.outputPath) }}">{{ 'readMethod' | t(lang) }} ↗</a></div>
  </aside>
  <div class="results">
   <div class="results-toolbar"><span id="result-count" aria-live="polite">{{ 'resultMany' | t(lang, {count: catalog.count}) }}</span><label class="sort-label">{{ 'sort' | t(lang) }}<select id="sort" aria-label="{{ 'sort' | t(lang) }}"><option value="model">{{ 'modelSort' | t(lang) }}</option><option value="company">{{ 'companySort' | t(lang) }}</option></select></label><button class="view-toggle" id="view" aria-label="{{ 'listView' | t(lang) }}" aria-pressed="false">☷</button></div>
   <div id="cards" class="cards">
    {% for p in products %}
    <article class="card" data-model="{{ p.model | escape }}" data-search="{{ (p.model + ' ' + p.ian + ' ' + (p.searchTitles | join(' ')) + ' ' + p.company) | lower | escape }}" data-category="{{ p.categoryKey | escape }}" data-company="{{ p.company | escape }}" data-power="{{ p.powerKey | escape }}" data-confirmed="{% if p.manufacturer %}true{% else %}false{% endif %}">
     <a class="card-link" href="{{ (lang + '/products/' + p.slug + '/index.html') | rel(page.outputPath) }}"><div class="card-art"><span class="micro">{{ p.category | escape }}</span>{{ media(p,lang,page.outputPath) }}<span class="open-arrow">↗</span></div><div class="card-info"><div class="card-meta"><span>IAN {{ p.ian }}</span><span>{{ p.power | escape }}</span></div><h3>{{ p.model | escape }}</h3><p class="product-name">{{ p.title | escape }}</p><div class="company"><span>{{ p.company | escape }}</span></div><span class="badge{% if p.manufacturer %} confirmed{% endif %}"><i></i>{% if p.manufacturer %}{% if p.manufacturer_basis == 'owner_confirmation' %}{{ 'manufacturerOwnerConfirmed' | t(lang) }}{% else %}{{ 'manufacturerVerified' | t(lang) }}{% endif %}{% else %}{{ 'manufacturerUnknown' | t(lang) }}{% endif %}</span></div></a>
    </article>
    {% endfor %}
   </div>
   <div id="empty" class="empty" hidden><h3>{{ 'emptyTitle' | t(lang) }}</h3><p>{{ 'emptyText' | t(lang) }}</p><button id="empty-reset">{{ 'resetFilters' | t(lang) }}</button></div><div class="more-wrap"><button id="more" class="secondary" hidden>{{ 'more' | t(lang) }} ↓</button><p id="shown"></p></div>
  </div>
 </div>
</section>
