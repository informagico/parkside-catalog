---
layout: layouts/base.njk
pageType: catalog
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang }}/index.html"
---
{% from 'components/media.njk' import media %}
{% set products = catalog.localized[lang] %}
{% set options = catalog.options[lang] %}
<div class="home-intro">
<section class="hero">
 <div class="hero-copy"><div class="eyebrow"><i></i>{{ 'eyebrow' | t(lang) }}</div><h1>{{ 'heroTitle' | t(lang) }}<br><em>{{ 'heroAccent' | t(lang) }}</em></h1><p>{{ 'heroText' | t(lang) }}</p><a class="primary" href="#catalogue">{{ 'explore' | t(lang) }} ↓</a><div class="hero-numbers"><div><b>{{ catalog.count }}</b><span>{{ 'records' | t(lang) }}</span></div><div><b>{{ catalog.models }}</b><span>{{ 'models' | t(lang) }}</span></div><div><b>{{ catalog.verified }}</b><span>{{ 'documented' | t(lang) }}</span></div></div></div>
</section>
<div class="manifesto"><span>{{ 'traceability' | t(lang) }}</span><p>{{ 'manifesto' | t(lang) }}</p><a href="{{ (lang + '/method/index.html') | rel(page.outputPath) }}#ian">{{ 'ianFindTitle' | t(lang) }} ↗</a></div>
</div>
<section id="catalogue" class="catalog" aria-labelledby="catalog-heading">
 <div class="catalog-controls">
 <div class="section-heading"><div><span class="eyebrow">{{ 'openArchive' | t(lang) }}</span><h2 id="catalog-heading">{{ 'catalogHeading' | t(lang) }}</h2></div><a href="{{ (lang + '/data/catalog.json') | rel(page.outputPath) }}" download>{{ 'export' | t(lang) }} ↓</a></div>
 <div class="search"><span aria-hidden="true">⌕</span><input id="search" type="search" aria-label="{{ 'search' | t(lang) }}" placeholder="{{ 'search' | t(lang) }}" enterkeyhint="search" autocomplete="off" spellcheck="false"><button id="search-clear" class="search-clear" type="button" aria-label="{{ 'clearSearch' | t(lang) }}" hidden>×</button><kbd>/</kbd><button id="scan-open" class="scan-open" type="button" aria-label="{{ 'scanOpen' | t(lang) }}" hidden aria-haspopup="dialog" aria-controls="label-scanner"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h4l2-3h4l2 3h4v15H4z"/><circle cx="12" cy="13" r="4"/></svg><span>{{ 'scanOpen' | t(lang) }}</span></button></div>
 <button id="filter-toggle" class="filter-toggle" type="button" aria-expanded="false" aria-controls="catalog-filters" hidden><span>{{ 'filterToggle' | t(lang) }}</span><span id="filter-count" hidden></span><span aria-hidden="true">⌄</span></button>
 </div>
 <div class="catalog-layout">
  <aside id="catalog-filters" class="filters" aria-label="{{ 'filters' | t(lang) }}">
   <div class="filter-heading">{{ 'filters' | t(lang) }}<button id="reset" type="button">{{ 'reset' | t(lang) }}</button></div>
   <label>{{ 'category' | t(lang) }}<select id="category"><option value="">{{ 'allCategories' | t(lang) }}</option>{% for item in options.categories %}<option value="{{ item.value | escape }}">{{ item.label | escape }}</option>{% endfor %}</select></label>
   <label>{{ 'company' | t(lang) }}<select id="company"><option value="">{{ 'allCompanies' | t(lang) }}</option>{% for item in options.companies %}<option value="{{ item.value | escape }}">{{ item.label | escape }}</option>{% endfor %}</select></label>
   <label>{{ 'power' | t(lang) }}<select id="power"><option value="">{{ 'allPower' | t(lang) }}</option>{% for item in options.power %}<option value="{{ item.value | escape }}">{{ item.label | escape }}</option>{% endfor %}</select></label>
   <label class="checkbox"><input type="checkbox" id="confirmed">{{ 'onlyDocumented' | t(lang) }}</label>
   <div class="filter-note"><span>↳ {{ 'oneSource' | t(lang) }}</span><p>{{ 'filterNote' | t(lang) }}</p><a href="{{ (lang + '/method/index.html') | rel(page.outputPath) }}">{{ 'readMethod' | t(lang) }} ↗</a></div>
  </aside>
  <div class="results">
   <div class="results-toolbar"><a class="compare-catalog-link" href="{{ (lang + '/compare/index.html') | rel(page.outputPath) }}" data-compare-link>{{ 'compareAdd' | t(lang) }}</a><span id="result-count" aria-live="polite">{{ 'resultMany' | t(lang, {count: catalog.count}) }}</span><label class="sort-label">{{ 'sort' | t(lang) }}<select id="sort" aria-label="{{ 'sort' | t(lang) }}"><option value="model">{{ 'modelSort' | t(lang) }}</option><option value="company">{{ 'companySort' | t(lang) }}</option></select></label><button class="view-toggle" id="view" aria-label="{{ 'listView' | t(lang) }}" aria-pressed="false">☷</button></div>
   <div id="catalog-results" class="results-scroll" tabindex="0" role="region" aria-labelledby="catalog-heading">
   <div id="cards" class="cards">
    {% for p in products %}
    <article class="card" data-model="{{ (p.model or p.title) | escape }}" data-search="{{ ((p.model or '') + ' ' + p.ian + ' ' + (p.searchTitles | join(' ')) + ' ' + (p.manufacturer or '') + ' ' + p.preview.batteryCapacity + ' ' + (p.preview.ranges | join(' '))) | lower | escape }}" data-category="{{ p.categoryKey | escape }}" data-company="{{ p.manufacturer | default('',true) | escape }}" data-power="{{ p.powerKey | escape }}" data-confirmed="{% if p.manufacturer %}true{% else %}false{% endif %}">
     <a class="card-link" href="{{ (lang + '/products/' + p.slug + '/index.html') | rel(page.outputPath) }}"><div class="card-art"><span class="micro">{{ p.category | escape }}</span>{{ media(p,lang,page.outputPath) }}<span class="open-arrow">↗</span></div><div class="card-info"><div class="card-meta"><span>IAN {{ p.ian }}</span>{% if p.powerKey != 'Unverified' and p.powerKey != 'To be verified' %}<span>{{ p.power | escape }}</span>{% endif %}</div><h3>{{ (p.model or p.title) | escape }}</h3>{% if p.model %}<p class="product-name">{{ p.title | escape }}</p>{% endif %}{% if p.manufacturer %}<div class="company"><span>{{ p.manufacturer | escape }}</span></div>{% endif %}{% if p.preview.batteryCapacity or p.preview.ranges.length or p.manual or p.preview.multipleModels or p.preview.modelIanCount > 1 %}<div class="card-badges">{% if p.preview.modelIanCount > 1 %}<span class="badge badge-models badge-ians" title="{{ 'multipleIansHint' | t(lang) }}">{{ 'multipleIansForModel' | t(lang, {count: p.preview.modelIanCount}) }}</span>{% endif %}{% if p.preview.batteryCapacity %}<span class="badge badge-range">{{ p.preview.batteryCapacity | escape }}</span>{% endif %}{% for range in p.preview.ranges %}<span class="badge badge-range">{{ range | escape }}</span>{% endfor %}{% if p.manual %}<span class="badge badge-manual">{{ 'manualAvailable' | t(lang) }}</span>{% endif %}{% if p.preview.multipleModels %}<span class="badge badge-models" title="{{ 'multipleModelsHint' | t(lang) }}">{{ 'multipleModelsForIan' | t(lang) }}</span>{% endif %}</div>{% endif %}</div></a>
     <button class="compare-toggle" type="button" data-compare-ian="{{ p.ian }}" data-compare-model="{{ (p.model or p.title) | escape }}" aria-pressed="false" hidden>{{ 'compareAdd' | t(lang) }}</button>
    </article>
    {% endfor %}
   </div>
   <div id="empty" class="empty" hidden><h3>{{ 'emptyTitle' | t(lang) }}</h3><p>{{ 'emptyText' | t(lang) }}</p><button id="empty-reset">{{ 'resetFilters' | t(lang) }}</button></div><div class="more-wrap"><button id="more" class="secondary" hidden>{{ 'more' | t(lang) }} ↓</button><p id="shown"></p></div>
   {% include 'components/footer.njk' %}
   </div>
  </div>
 </div>
</section>

{% include 'components/scanner.njk' %}
