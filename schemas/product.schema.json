{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/informagico/parkside-catalog/schemas/product.schema.json",
  "title": "Parkside Atlas product frontmatter",
  "type": "object",
  "required": [
    "model",
    "ian",
    "title",
    "category",
    "power",
    "manufacturer",
    "specifications"
  ],
  "allOf": [
    {
      "if": {"properties": {"category": {"const": "Batteries"}}, "required": ["category"]},
      "then": {
        "properties": {
          "specifications": {
            "required": ["Battery capacity"],
            "properties": {"Battery capacity": {"type": "string", "pattern": "^[0-9]+\\.[0-9] Ah(?: / [0-9]+\\.[0-9] Ah)*$"}}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"power": {"enum": ["12 V battery", "20 V battery", "40 V battery"]}}, "required": ["power"]},
            "then": {"properties": {"specifications": {"required": ["Battery system"], "properties": {"Battery system": {"type": "string", "minLength": 1}}}}}
          }
        ]
      }
    }
  ],
  "properties": {
    "model": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Documented model code, or null when it is not known. Never use the IAN as a model."
    },
    "ian": {
      "type": "string",
      "pattern": "^[0-9]{5,6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "Gardening",
        "Drilling & Fastening",
        "Sawing & Cutting",
        "Sanding & Grinding",
        "Cleaning & Extraction",
        "Welding & Soldering",
        "Measuring & Detection",
        "Workshop Equipment",
        "Batteries",
        "Accessories"
      ],
      "description": "Choose one exact canonical English category from content/categories.json."
    },
    "power": {
      "type": "string"
    },
    "company": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ]
    },
    "oem": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://"
    },
    "technical_source": {
      "type": "string",
      "pattern": "^https://"
    },
    "market": {
      "type": [
        "string",
        "null"
      ]
    },
    "specifications": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "string",
      "minLength": 0
    },
    "manufacturer_basis": {
      "type": "string",
      "enum": [
        "documents",
        "owner_confirmation"
      ],
      "description": "Whether attribution is supported by archived manufacturer documents or explicitly confirmed by the catalog owner. Omitted for existing document-based records."
    },
    "image": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "HTTPS URL or assets/products/<filename>.jpg, .jpeg, .png, .webp or .svg"
        },
        "source": {
          "type": "string",
          "pattern": "^https://"
        },
        "credit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "manual": {
      "type": "string",
      "pattern": "^https://",
      "description": "Optional product manual PDF URL."
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "description": "Optional warranty and service PDFs. These do not count as operating manuals.",
      "items": {
        "type": "object",
        "required": ["type", "url"],
        "properties": {
          "type": {"type": "string", "enum": ["warranty"]},
          "url": {"type": "string", "pattern": "^https://"}
        },
        "additionalProperties": false
      }
    },
    "manuals": {
      "type": "array",
      "minItems": 1,
      "description": "Optional manuals for separate variants under this IAN. If manual is also set, its URL must be included in this list; otherwise the first entry is used as the primary manual.",
      "items": {
        "type": "object",
        "required": ["model", "url"],
        "properties": {
          "model": {"type": "string", "pattern": "\\S", "description": "Model code identifying the variant covered by this manual."},
          "url": {"type": "string", "pattern": "^https://"}
        },
        "additionalProperties": false
      }
    }
  }
}
