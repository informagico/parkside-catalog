{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/informagico/parkside-catalog/schemas/product.schema.json",
  "title": "Parkside Atlas product frontmatter",
  "type": "object",
  "required": [
    "model",
    "ian",
    "title",
    "category",
    "power",
    "company",
    "manufacturer",
    "source",
    "specifications",
    "evidence"
  ],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "ian": {
      "type": "string",
      "pattern": "^[0-9]{5,6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "Gardening",
        "Drilling & Fastening",
        "Sawing & Cutting",
        "Sanding & Grinding",
        "Cleaning & Extraction",
        "Welding & Soldering",
        "Measuring & Detection",
        "Workshop Equipment",
        "Batteries & Accessories"
      ],
      "description": "Choose one exact canonical English category from content/categories.json."
    },
    "power": {
      "type": "string"
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ]
    },
    "oem": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "pattern": "^https://"
    },
    "technical_source": {
      "type": "string",
      "pattern": "^https://"
    },
    "market": {
      "type": [
        "string",
        "null"
      ]
    },
    "specifications": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "manufacturer_basis": {
      "type": "string",
      "enum": [
        "documents",
        "owner_confirmation"
      ],
      "description": "Whether attribution is supported by archived manufacturer documents or explicitly confirmed by the catalog owner. Omitted for existing document-based records."
    },
    "image": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "url",
        "source",
        "credit"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "HTTPS URL or assets/products/<filename>.jpg, .jpeg, .png or .webp"
        },
        "source": {
          "type": "string",
          "pattern": "^https://"
        },
        "credit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
