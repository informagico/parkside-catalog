{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product translation by IAN",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "_sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "specifications": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
